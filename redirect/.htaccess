RewriteEngine On

# Redirect my.indoquran.web.id to indoquran.web.id
RewriteCond %{HTTP_HOST} ^my\.indoquran\.web\.id$ [NC]
RewriteRule ^(.*)$ https://indoquran.web.id/$1 [R=301,L]

RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://indoquran.web.id%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTPS} =on
RewriteRule ^(.*)$ https://indoquran.web.id%{REQUEST_URI} [R=301,L]