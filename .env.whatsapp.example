# WhatsApp Service Configuration (Add these to your .env file)

# Simple wa.me URL approach (No API credentials needed)
# This follows the same pattern as your existing WhatsApp sharing functionality
# The system generates wa.me URLs that automatically open WhatsApp with the message

# Default from number for formatting (optional)
WHATSAPP_FROM_NUMBER=+6281234567890

# Alternative API-based configurations (if you want to use actual WhatsApp APIs later):

# For Twilio WhatsApp API:
# WHATSAPP_API_URL=https://api.twilio.com/2010-04-01/Accounts/{AccountSid}/Messages.json
# WHATSAPP_API_KEY=your_twilio_auth_token
# WHATSAPP_FROM_NUMBER=whatsapp:+14155238886

# For MessageBird WhatsApp API:
# WHATSAPP_API_URL=https://conversations.messagebird.com/v1/conversations/start
# WHATSAPP_API_KEY=your_messagebird_api_key
# WHATSAPP_FROM_NUMBER=+31644556677

# For WhatsApp Business API (Official):
# WHATSAPP_API_URL=https://graph.facebook.com/v17.0/{phone_number_id}/messages
# WHATSAPP_API_KEY=your_facebook_access_token
# WHATSAPP_FROM_NUMBER=your_whatsapp_business_phone_number

# Current Implementation Notes:
# - Uses the same wa.me URL approach as your existing sharing features
# - No API credentials required
# - Works exactly like sharing ayah, surah, or doa features
# - Automatically detects mobile vs desktop and uses appropriate WhatsApp interface
# - Generates URLs like: https://wa.me/6281234567890?text=Your%20password%20reset%20message
