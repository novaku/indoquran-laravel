    }
  ],
  "shortcuts": [
    {
      "name": "Baca Al-Quran",
      "short_name": "Baca",
      "description": "Langsung ke halaman baca Al-Quran",
      "url": "/quran?utm_source=pwa_shortcut",
      "icons": [
        {
          "src": "/android-chrome-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Jadwal Sholat",
      "short_name": "Sholat",
      "description": "Cek jadwal sholat hari ini",
      "url": "/prayer?utm_source=pwa_shortcut",
      "icons": [
        {
          "src": "/android-chrome-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Pencarian Ayat",
      "short_name": "Cari",
      "description": "Cari ayat dalam Al-Quran",
      "url": "/search?utm_source=pwa_shortcut",
      "icons": [
        {
          "src": "/android-chrome-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Bookmark Saya",
      "short_name": "Bookmark",
      "description": "Akses bookmark ayat favorit",
      "url": "/bookmarks?utm_source=pwa_shortcut",
      "icons": [
        {
          "src": "/android-chrome-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "share_target": {
    "action": "/share",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+quran",
      "url": "/surah/%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/bookmarks/import",
      "accept": {
        "application/json": [".json"],
        "text/plain": [".txt"]
      }
    }
  ],
