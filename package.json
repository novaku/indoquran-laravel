{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "version": "2.16.0",
    "scripts": {
        "build": "vite build --mode production",
        "build:analyze": "vite build --mode production && npx vite-bundle-analyzer",
        "build:optimized": "./build-optimized.sh",
        "dev": "vite",
        "dev:host": "vite --host",
        "preview": "vite preview",
        "react:dev": "concurrently \"php artisan serve\" \"npm run dev\"",
        "watch": "vite build --watch",
        "react-devtools": "react-devtools",
        "optimize:images": "./optimize-images.sh",
        "build:production": "./build-production.sh",
        "performance:test": "npx lighthouse --view --chrome-flags='--headless' http://localhost:8000",
        "performance:ci": "npx lighthouse --output=json --output-path=./lighthouse-report.json --chrome-flags='--headless' http://localhost:8000",
        "performance:pagespeed": "npx lighthouse --form-factor=mobile --throttling-method=simulate --chrome-flags='--headless' --view http://localhost:8000",
        "performance:mobile": "npx lighthouse --form-factor=mobile --throttling-method=simulate --only-categories=performance --chrome-flags='--headless' --view http://localhost:8000",
        "performance:quick": "npx lighthouse --only-categories=performance --chrome-flags='--headless' --view http://localhost:8000",
        "bundle:analyze": "npx vite-bundle-analyzer public/build",
        "bundle:size": "./analyze-bundle.sh",
        "pwa:test": "./test-pwa.sh",
        "pwa:audit": "npx lighthouse --view --only-categories=pwa http://localhost:8000",
        "pwa:build": "npm run build && npm run pwa:test",
        "test:canonical": "./test-canonical-url.sh",
        "test:seo": "./test-canonical-url.sh && npm run pwa:test"
    },
    "devDependencies": {
        "@babel/preset-react": "^7.27.1",
        "@tailwindcss/forms": "^0.5.10",
        "@tailwindcss/postcss": "^4.1.8",
        "@tailwindcss/typography": "^0.5.16",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-react": "^4.5.1",
        "alpinejs": "^3.14.9",
        "autoprefixer": "^10.4.21",
        "axios": "^1.8.2",
        "babel-plugin-transform-remove-console": "^6.9.4",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^1.2.0",
        "lighthouse": "^12.8.1",
        "postcss": "^8.5.4",
        "react": "^18.3.1",
        "react-devtools": "^6.1.2",
        "react-dom": "^18.3.1",
        "tailwindcss": "^4.1.8",
        "terser": "^5.43.1",
        "vite": "^6.2.4"
    },
    "dependencies": {
        "@heroicons/react": "^2.2.0",
        "@tailwindcss/line-clamp": "^0.4.4",
        "@tiptap/extension-image": "^3.10.1",
        "@tiptap/extension-link": "^3.10.1",
        "@tiptap/extension-placeholder": "^3.10.1",
        "@tiptap/extension-text-align": "^3.10.1",
        "@tiptap/extension-underline": "^3.10.1",
        "@tiptap/react": "^3.10.1",
        "@tiptap/starter-kit": "^3.10.1",
        "chart.js": "^4.5.0",
        "date-fns": "^4.1.0",
        "framer-motion": "^12.18.1",
        "prop-types": "^15.8.1",
        "react-chartjs-2": "^5.3.0",
        "react-hot-toast": "^2.5.2",
        "react-icons": "^5.5.0",
        "react-router-dom": "^6.30.1",
        "web-vitals": "^4.2.4"
    }
}
